        <mxCell id="arrow_y2_to_y0_data_lbl" value="data" style="edgeLabel;html=1;fontSize=9;fontStyle=1;fontColor=#b85450;" vertex="1" connectable="0" parent="arrow_y2_to_y0_data">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-10" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- GREEN DOWN: y=2 step 10 → y=0 step 5/6  (completion signal) -->
        <mxCell id="arrow_y2_to_y0_done" style="strokeColor=#82b366;strokeWidth=2;endFill=1;dashed=1;dashPattern=8 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
