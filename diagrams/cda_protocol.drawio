          <mxGeometry x="350" y="790" width="300" height="25" as="geometry"/>
        </mxCell>

        <!-- Barrier core y=0 (Leader) -->
        <mxCell id="bar_y0" value="y=0&#xa;Leader" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
