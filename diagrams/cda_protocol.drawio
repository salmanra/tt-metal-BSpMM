        <!-- Red dashed: y=0 → y=2 (inc release_sem) -->
        <mxCell id="bar_y0_to_y2" style="strokeColor=#b85450;strokeWidth=2;endFill=1;dashed=1;dashPattern=8 4;curved=1;" edge="1" parent="1">
