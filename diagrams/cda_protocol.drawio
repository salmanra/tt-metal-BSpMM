          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-10" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- ======= CALLOUT: Slot Encoding ======= -->
        <mxCell id="callout_slot" value="Slot Encoding:&#xa;sem value 1 → slot 0 (base)&#xa;sem value 2 → slot 1 (base+size)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="415" y="500" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- ======= DOUBLE BUFFER DIAGRAM ======= -->
