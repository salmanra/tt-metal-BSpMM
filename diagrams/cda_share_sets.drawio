        <!-- ===== CHAIN LABELS (on left side) ===== -->
        <mxCell id="lbl_a" value="&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;Set A&lt;/b&gt;&lt;br&gt;col=5&lt;br&gt;{0,2,5}&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="55" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_b" value="&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;Set B&lt;/b&gt;&lt;br&gt;col=3&lt;br&gt;{1,4,6}&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="55" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_c" value="&lt;font color=&quot;#6aa84f&quot;&gt;&lt;b&gt;Set C&lt;/b&gt;&lt;br&gt;col=7&lt;br&gt;{3,7}&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="55" height="45" as="geometry"/>
