        <mxCell id="chain_b_6_4" value="" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=3;endFill=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;curved=1;" edge="1" parent="1" source="c6" target="c4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="649"/>
              <mxPoint x="190" y="517"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="chain_b_4_1" value="" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=3;endFill=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;curved=1;" edge="1" parent="1" source="c4" target="c1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="494"/>
              <mxPoint x="190" y="286"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Set C (green): y=7 → y=3 -->
        <!-- Arrows even more to the left -->
        <mxCell id="chain_c_7_3" value="" style="endArrow=block;html=1;strokeColor=#6aa84f;strokeWidth=3;endFill=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;curved=1;" edge="1" parent="1" source="c7" target="c3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="165" y="726"/>
              <mxPoint x="165" y="440"/>
            </Array>
