        <mxCell id="dram_b_lbl" value="&lt;font color=&quot;#6c8ebf&quot; style=&quot;font-size:9px&quot;&gt;DRAM read&lt;br&gt;(col 3)&lt;/font&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="dram_b">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Set C: DRAM → y=7 -->
        <mxCell id="dram_c" value="" style="endArrow=block;html=1;strokeColor=#6aa84f;strokeWidth=2;endFill=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.7;exitY=1;exitDx=0;exitDy=0;curved=1;" edge="1" parent="1" source="dram" target="c7">
