        <mxCell id="dram_c_lbl" value="&lt;font color=&quot;#6aa84f&quot; style=&quot;font-size:9px&quot;&gt;DRAM read&lt;br&gt;(col 7)&lt;/font&gt;" style="edgeLabel;html=1;fontSize=9;" vertex="1" connectable="0" parent="dram_c">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint x="40" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== CDA CHAIN ARROWS ===== -->
        <!-- Set A (red): y=5 → y=2 → y=0 -->
        <!-- Arrows on the LEFT side of the cores -->
        <mxCell id="chain_a_5_2" value="" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=3;endFill=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;curved=1;" edge="1" parent="1" source="c5" target="c2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="215" y="572"/>
              <mxPoint x="215" y="363"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="chain_a_2_0" value="" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=3;endFill=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;curved=1;" edge="1" parent="1" source="c2" target="c0">
