        </mxCell>
        <mxCell id="legend_title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="172" width="200" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="leg_a" value="&lt;font style=&quot;font-size:9px&quot;&gt;Set A (col_idx=5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="510" y="198" width="180" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="leg_b" value="&lt;font style=&quot;font-size:9px&quot;&gt;Set B (col_idx=3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="510" y="222" width="180" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="leg_c" value="&lt;font style=&quot;font-size:9px&quot;&gt;Set C (col_idx=7)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="510" y="246" width="180" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="leg_inj" value="&lt;font style=&quot;font-size:9px&quot;&gt;Thick border = Injector (max y)&lt;br&gt;Reads from DRAM, chains data&lt;br&gt;upward to other set members&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="510" y="272" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="leg_chain" value="&lt;font style=&quot;font-size:9px&quot;&gt;Colored arrows = CDA chain&lt;br&gt;direction (injector → tail)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=9;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="510" y="314" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="leg_note" value="&lt;font style=&quot;font-size:9px&quot;&gt;3 independent chains operate&lt;br&gt;concurrently on the same column&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=9;strokeColor=none;fillColor=none;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="510" y="346" width="180" height="25" as="geometry"/>
        </mxCell>

        <!-- Key insight annotation -->
        <mxCell id="insight" value="&lt;b&gt;Key property:&lt;/b&gt; Multiple independent CDA chains&lt;br&gt;coexist within the same physical column.&lt;br&gt;Each chain uses its own sender/receiver semaphore&lt;br&gt;handshake — no interference between chains." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="800" width="350" height="65" as="geometry"/>
