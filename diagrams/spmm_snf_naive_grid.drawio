        <mxCell id="snf_anno" value="&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;A (sparse): SnF, RISCV_0, NoC 0&lt;/b&gt;&lt;br&gt;1 DRAM read per row → forwarded L→R&lt;br&gt;Each hop carries exactly 1 stream&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
