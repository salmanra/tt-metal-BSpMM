        </mxCell>
        <mxCell id="naive_anno" value="&lt;font color=&quot;#4472C4&quot;&gt;&lt;b&gt;B (dense): Naive, RISCV_1, NoC 1&lt;/b&gt;&lt;br&gt;Every core reads B from DRAM independently (B→T)&lt;br&gt;All 4 streams in a column share the same vertical&lt;br&gt;NoC links → congestion increases toward DRAM&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
